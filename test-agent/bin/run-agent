#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: run-agent --stack backend|frontend --mode run|repair [--workspace DIR]" >&2
  exit 2
}

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
stack="" mode="" workspace=""
while (( $# )); do
  case "$1" in
    --stack) stack="${2:-}"; shift 2 ;;
    --mode) mode="${2:-}"; shift 2 ;;
    --workspace) workspace="${2:-}"; shift 2 ;;
    *) usage ;;
  esac
done
[[ "$stack" == "backend" || "$stack" == "frontend" ]] || usage
workspace="${workspace:-.test-agent/$stack}"
[[ "$workspace" =~ ^[A-Za-z0-9._/-]+$ && "$workspace" != /* && "$workspace" != *..* ]] \
  || { echo "run-agent: the workspace must be a repository-relative directory" >&2; exit 2; }

if [[ -n "${TEST_AGENT_PYTHON:-}" ]]; then
  python_bin="$TEST_AGENT_PYTHON"
elif [[ -x "$repo_root/test-agent/.venv/bin/python" ]]; then
  python_bin="$repo_root/test-agent/.venv/bin/python"
elif [[ -x "$repo_root/test-agent/.venv/Scripts/python.exe" ]]; then
  python_bin="$repo_root/test-agent/.venv/Scripts/python.exe"
else
  python_bin="python3"
fi
tool() { "$python_bin" "$repo_root/test-agent/main.py" "$@"; }

cd "$repo_root"
[[ -f "$workspace/analysis.json" ]] || { echo "run-agent: run the analyze command first; $workspace/analysis.json is missing" >&2; exit 2; }

case "$mode" in
  run)
    prompt="Stack: $stack
Analysis: $workspace/analysis.json

Work through your workflow and finish with the report."
    session_args=()
    : > "$workspace/transcript.jsonl"
    ;;
  repair)
    session="$(cat "$workspace/session.txt" 2>/dev/null || true)"
    [[ "$session" =~ ^[0-9a-f-]{36}$ ]] || { echo "run-agent: no previous session to repair" >&2; exit 2; }
    [[ -f "$workspace/selfcheck.json" ]] || { echo "run-agent: run the selfcheck command first" >&2; exit 2; }
    prompt="Stack: $stack
Mode: repair
Failing suite: $workspace/selfcheck.json

The full $stack suite fails after your changes. Open that file, fix every failing test with the test-verification skill, run the full suite until it is green, then return the report for the whole run."
    session_args=(--resume "$session")
    ;;
  *) usage ;;
esac

settings="$(mktemp)"
trap 'rm -f "$settings"' EXIT
tool claude-settings --stack "$stack" > "$settings"

set +e
claude -p "$prompt" \
  "${session_args[@]}" \
  --agent test-engineer \
  --model "${TEST_AGENT_MODEL:-claude-sonnet-5-5}" \
  --setting-sources project \
  --settings "$settings" \
  --strict-mcp-config \
  --permission-mode dontAsk \
  --tools "Read,Edit,Write,Glob,Grep,Bash,Skill" \
  --disallowedTools "WebFetch,WebSearch" \
  --max-turns "${TEST_AGENT_MAX_TURNS:-80}" \
  --max-budget-usd "${TEST_AGENT_MAX_BUDGET_USD:-5}" \
  --json-schema "$(tool schema)" \
  --output-format stream-json --verbose \
  < /dev/null >> "$workspace/transcript.jsonl"
claude_status=$?
set -e

tool redact --file "$workspace/transcript.jsonl" \
  --env ANTHROPIC_API_KEY --env CLAUDE_CODE_OAUTH_TOKEN --env ANTHROPIC_AUTH_TOKEN
tool transcript --workspace "$workspace"
echo "run-agent: claude exited with $claude_status"
cat "$workspace/agent-run.json"
